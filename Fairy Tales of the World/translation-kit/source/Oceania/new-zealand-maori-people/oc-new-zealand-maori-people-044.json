   "id": "p007"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p008.s01",
     "source": "Maronui."
    },
    {
     "id": "p008.s02",
     "source": "A married man or woman."
    },
    {
     "id": "p008.s03",
     "source": "Takakau."
    },
    {
     "id": "p008.s04",
     "source": "A single man or woman."
    },
    {
     "id": "p008.s05",
     "source": "Pouaru."
    },
    {
     "id": "p008.s06",
     "source": "A widow."
    }
   ],
   "id": "p008"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p009.s01",
     "source": "Puhi."
    },
    {
     "id": "p009.s02",
     "source": "A betrothed female, also a female of rank restricted from marriage."
    },
    {
     "id": "p009.s03",
     "source": "He wahine taumaro."
    },
    {
     "id": "p009.s04",
     "source": "A betrothed female."
    },
    {
     "id": "p009.s05",
     "source": "N.B.—There is a distinction between a Puhi and a wahine taumaro ."
    },
    {
     "id": "p009.s06",
     "source": "The betrothed female is a Puhi in reference to her father’s act of consent, and a wahine taumaro in reference to her future father-in-law’s act of consent to the arrangement."
    }
   ],
