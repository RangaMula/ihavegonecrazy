     "source": "Matua."
    },
    {
     "id": "p002.s02",
     "source": "A father, or uncle either patruus or avunculus."
    }
   ],
   "id": "p002"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p003.s01",
     "source": "Papa."
    },
    {
     "id": "p003.s02",
     "source": "The same."
    },
    {
     "id": "p003.s03",
     "source": "Whaea."
    },
    {
     "id": "p003.s04",
     "source": "A mother, or aunt on either side."
    },
    {
     "id": "p003.s05",
     "source": "Tama."
    },
    {
     "id": "p003.s06",
     "source": "Eldest nephew."
    },
    {
     "id": "p003.s07",
     "source": "Tamahine."
    },
    {
     "id": "p003.s08",
     "source": "Eldest niece; also used more generally."
    },
    {
     "id": "p003.s09",
     "source": "Tamaiti."
    },
    {
     "id": "p003.s10",
     "source": "Son, or nephew."
    },
    {
     "id": "p003.s11",
     "source": "Tamaroa."
    },
    {
     "id": "p003.s12",
     "source": "The same."
    }
   ],
   "id": "p003"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p004.s01",
     "source": "Tuakana."
    },
    {
     "id": "p004.s02",
     "source": "Elder brother of males, elder sister of females; also elder brother’s children in reference to younger brother’s children, elder sister’s children in reference to younger sister’s children."
    }
   ],
   "id": "p004"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p005.s01",
     "source": "Teina."
    },
    {
     "id": "p005.s02",
     "source": "The younger brother of males, the younger sister of females; also the younger brother’s children in reference to elder brother’s children, the younger sister’s children in reference to elder sister’s children."
    },
    {
     "id": "p005.s03",
     "source": "Tungane."
    },
    {
     "id": "p005.s04",
     "source": "A sister’s brother."
    },
    {
     "id": "p005.s05",
     "source": "Tuahine."
    },
    {
     "id": "p005.s06",
     "source": "A brother’s sister."
    }
   ],
   "id": "p005"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p006.s01",
     "source": "Iramutu."
    },
    {
     "id": "p006.s02",
     "source": "A nephew, or niece."
    },
    {
     "id": "p006.s03",
     "source": "Hungawai."
    },
    {
     "id": "p006.s04",
     "source": "A father-in-law, or mother-in-law."
    },
    {
     "id": "p006.s05",
     "source": "Hunaonga."
    },
    {
     "id": "p006.s06",
     "source": "A son-in-law, or daughter-in-law."
    },
    {
     "id": "p006.s07",
     "source": "Taokete."
    },
    {
     "id": "p006.s08",
     "source": "A man’s brother-in-law, or sister’s sister-in-law."
    },
    {
     "id": "p006.s09",
     "source": "Autane."
    },
    {
     "id": "p006.s10",
     "source": "A woman’s brother-in-law."
    },
    {
     "id": "p006.s11",
     "source": "Auwahine."
    },
    {
     "id": "p006.s12",
     "source": "A man’s sister-in-law."
    },
    {
     "id": "p006.s13",
     "source": "Potiki."
    },
    {
     "id": "p006.s14",
     "source": "A brother’s children, or sister’s children; also the youngest child of a family."
    },
    {
     "id": "p006.s15",
     "source": "Mokopuna."
    },
    {
     "id": "p006.s16",
     "source": "A grand-child, or child of a nephew or niece."
    },
    {
     "id": "p006.s17",
     "source": "Huanga."
    },
    {
     "id": "p006.s18",
     "source": "A relation in general."
    },
    {
     "id": "p006.s19",
     "source": "Whanaunga-tutu."
    },
    {
     "id": "p006.s20",
     "source": "A blood relation."
    }
   ],
   "id": "p006"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p007.s01",
     "source": "Ariki."
    },
    {
     "id": "p007.s02",
     "source": "The first born male or female."
    },
    {
     "id": "p007.s03",
     "source": "Waewae."
    },
    {
     "id": "p007.s04",
     "source": "A man’s younger brother: literally the foot."
    },
    {
     "id": "p007.s05",
     "source": "Hamua."
    },
    {
     "id": "p007.s06",
     "source": "Syn. tuakana."
    }
