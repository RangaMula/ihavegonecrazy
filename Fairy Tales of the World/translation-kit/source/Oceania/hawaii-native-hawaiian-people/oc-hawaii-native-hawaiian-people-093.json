 },
 "paragraphs": [
  {
   "type": "prose",
   "segments": [
    {
     "id": "p001.s01",
     "source": "###"
    }
   ],
   "id": "p001"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p002.s01",
     "source": "When from the terrors of Nature a people have fashion’d and worship a Spirit of Evil"
    }
   ],
   "id": "p002"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p003.s01",
     "source": "Blest be the Voice of the Teacher who calls to them,"
    }
   ],
   "id": "p003"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p004.s01",
     "source": "“Set yourselves free!”"
    }
   ],
   "id": "p004"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p005.s01",
     "source": "###"
    }
   ],
   "id": "p005"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p006.s01",
     "source": "Noble the Saxon who hurled at his Idol a valorous weapon in olden England!"
    }
   ],
   "id": "p006"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p007.s01",
     "source": "Great, and greater, and greatest of women, island heroine Kapiolani"
    }
   ],
   "id": "p007"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p008.s01",
     "source": "Clomb the mountain, and flung the berries and dared the Goddess, and freed the people"
    }
   ],
   "id": "p008"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p009.s01",
     "source": "Of Hawa-i-ee!"
    }
   ],
   "id": "p009"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p010.s01",
     "source": "###"
    }
   ],
   "id": "p010"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p011.s01",
     "source": "A people believing that Peelè the Goddess would wallow in fiery riot and revel"
    }
   ],
   "id": "p011"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p012.s01",
     "source": "On Kilauea,"
    }
   ],
   "id": "p012"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p013.s01",
     "source": "Dance in a fountain of flame with her devils or shake with her thunders and shatter her island,"
    }
   ],
   "id": "p013"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p014.s01",
     "source": "Rolling her anger"
    }
   ],
   "id": "p014"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p015.s01",
     "source": "Thro’ blasted valley and flowing forest in blood-red cataracts down to the sea!"
    }
   ],
   "id": "p015"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p016.s01",
     "source": "[ ]"
    }
   ],
   "id": "p016"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p017.s01",
     "source": "###"
    }
   ],
   "id": "p017"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p018.s01",
     "source": "Long as the lava-light"
    }
   ],
   "id": "p018"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p019.s01",
     "source": "Glares from the lava-lake,"
    }
   ],
   "id": "p019"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p020.s01",
     "source": "Dazing the starlight;"
    }
   ],
   "id": "p020"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p021.s01",
     "source": "Long as the silvery vapor in daylight,"
    }
   ],
   "id": "p021"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p022.s01",
     "source": "Over the mountain"
    }
   ],
   "id": "p022"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p023.s01",
     "source": "Floats, will the glory of Kapiolani be mingled with either on Hawa-i-ee."
    }
   ],
   "id": "p023"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p024.s01",
     "source": "###"
    }
   ],
   "id": "p024"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p025.s01",
     "source": "What said her Priesthood?"
    }
   ],
   "id": "p025"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p026.s01",
     "source": "“Woe to this island if ever a woman should handle or gather the berries of Peelè!"
    }
   ],
   "id": "p026"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p027.s01",
     "source": "Accursed were she!"
    }
   ],
   "id": "p027"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p028.s01",
     "source": "And woe to this island if ever a woman should climb to the dwelling of Peelè the Goddess!"
    }
   ],
   "id": "p028"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p029.s01",
     "source": "Accursed were she!”"
    }
   ],
   "id": "p029"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p030.s01",
     "source": "###"
    }
   ],
   "id": "p030"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p031.s01",
     "source": "One from the Sunrise"
    }
   ],
   "id": "p031"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p032.s01",
     "source": "Dawned on His people and slowly before him"
    }
   ],
   "id": "p032"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p033.s01",
     "source": "Vanished shadow-like"
    }
   ],
   "id": "p033"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p034.s01",
     "source": "Gods and Goddesses,"
    }
   ],
   "id": "p034"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p035.s01",
     "source": "None but the terrible Peelè remaining as Kapiolani"
    }
   ],
   "id": "p035"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p036.s01",
     "source": "Ascended her mountain,"
    }
   ],
   "id": "p036"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p037.s01",
     "source": "Baffled her priesthood,"
    }
   ],
   "id": "p037"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p038.s01",
     "source": "Broke the Taboo,"
    }
   ],
   "id": "p038"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p039.s01",
     "source": "Dipt to the crater,"
    }
   ],
   "id": "p039"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p040.s01",
     "source": "Called on the Power adored by the Christian and crying, “I dare her, let Peelè avenge herself!”"
    }
   ],
   "id": "p040"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p041.s01",
     "source": "Into the flame-billows dashed the berries, and drove the demon from Hawa-i-ee."
    }
   ],
   "id": "p041"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p042.s01",
     "source": "[ ]"
    }
   ],
   "id": "p042"
  }
 ]
}