 "paragraphs": [
  {
   "type": "prose",
   "segments": [
    {
     "id": "p001.s01",
     "source": "Un vendedor de coquitos tenía la costumbre, en vez de pregonar su mercadería, de hacerla sonar moviendo repetidas veces, de arriba abajo, el canasto que la contenía."
    }
   ],
   "id": "p001"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p002.s01",
     "source": "Se le acerca un gabacho que no habla castellano ni conoce los coquitos, y pregunta:"
    }
   ],
   "id": "p002"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p003.s01",
     "source": "—Comment s’apelle—ça?"
    }
   ],
   "id": "p003"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p004.s01",
     "source": "—Si no se pelan, ñor, se parten."
    }
   ],
   "id": "p004"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p005.s01",
     "source": "—Comment?"
    }
   ],
   "id": "p005"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p006.s01",
     "source": "—¡Con la mano!"
    },
    {
     "id": "p006.s02",
     "source": "No, iñor, con pieira."
    }
   ],
   "id": "p006"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p007.s01",
     "source": "—Je ne comprend pas."
    }
   ],
   "id": "p007"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p008.s01",
     "source": "—Y si no habís de comprar ¿pa qué preguntay, gringo tal por cual?"
    }
   ],
   "id": "p008"
  }
 ]
}