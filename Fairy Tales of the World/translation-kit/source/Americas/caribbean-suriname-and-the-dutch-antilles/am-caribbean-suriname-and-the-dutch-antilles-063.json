 },
 "paragraphs": [
  {
   "type": "prose",
   "segments": [
    {
     "id": "p001.s01",
     "source": "In vroeger tijden leefde de Dood niet onder de menschen, maar heer Spin lokte hem uit het bosch."
    }
   ],
   "id": "p001"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p002.s01",
     "source": "Op zekeren morgen ging Anansi als gewoonlijk naar het woud met zijn koeroe-koeroe * op zijn rug en ging den Dood opzoeken:"
    }
   ],
   "id": "p002"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p003.s01",
     "source": "… en ging den Dood opzoeken.—Zie blz. ."
    }
   ],
   "id": "p003"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p004.s01",
     "source": "„ Odi mâti Déde! ”"
    }
   ],
   "id": "p004"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p005.s01",
     "source": "„.…. ”"
    }
   ],
   "id": "p005"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p006.s01",
     "source": "„Ik groet U vriend!”"
    }
   ],
   "id": "p006"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p007.s01",
     "source": "„.…. ”"
    }
   ],
   "id": "p007"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p008.s01",
     "source": "„Hm!” dacht heer Spin, die een brabakóto met gedroogd vleesch zag staan, „dat is een goed teeken."
    },
    {
     "id": "p008.s02",
     "source": "Vriend, kan ik wat van dat gedroogde vleesch nemen?”"
    }
   ],
   "id": "p008"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p009.s01",
     "source": "„.…. ”"
    }
   ],
   "id": "p009"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p010.s01",
     "source": "„Ik heb een mooie dochter, vriend, ik zal ze je tot vrouw geven!”"
    }
   ],
   "id": "p010"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p011.s01",
     "source": "„.…. ”"
    }
   ],
   "id": "p011"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p012.s01",
     "source": "Heer Spin vulde zijn koeroe-koeroe * en vertrok."
    },
    {
     "id": "p012.s02",
     "source": "Thuis gekomen, vertelde hij zijn vrouw, dat hij een vriend had gevonden, die alles voor hem over had, en dat hij hem zijn dochter Akoeba tot vrouw wilde geven."
    }
   ],
   "id": "p012"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p013.s01",
     "source": "Den volgenden dag herhaalde heer Spin zijn bezoek. [ ]"
    }
   ],
   "id": "p013"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p014.s01",
     "source": "„Ik groet je, vriend Dood!”"
    }
   ],
   "id": "p014"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p015.s01",
     "source": "„.…. ”"
    }
   ],
   "id": "p015"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p016.s01",
     "source": "„ Akoeba laat je groeten!”"
    }
   ],
   "id": "p016"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p017.s01",
     "source": "„.…. ”"
    }
   ],
   "id": "p017"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p018.s01",
     "source": "Heer Spin vulde weêr zijn koeroe-koeroe en ging weêr heen."
    },
    {
     "id": "p018.s02",
     "source": "Zoo kwam hij iederen dag terug, tot al het gedroogde vleesch op was."
    },
    {
     "id": "p018.s03",
     "source": "Den dag daarop kwam hij met zijn dochter Akoeba , die hij zijn vriend wilde voorstellen."
    },
    {
     "id": "p018.s04",
     "source": "Ook nu weêr had hij zijn korf meêgenomen."
    }
   ],
   "id": "p018"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p019.s01",
     "source": "„Dag vriend!”"
    }
   ],
   "id": "p019"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p020.s01",
     "source": "„.…. ”"
    }
   ],
   "id": "p020"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p021.s01",
     "source": "„ Akoeba is je komen bezoeken!”"
    }
   ],
   "id": "p021"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p022.s01",
     "source": "„.…. ”"
    }
   ],
   "id": "p022"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p023.s01",
     "source": "„ Akoeba groet je!”"
    }
   ],
   "id": "p023"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p024.s01",
     "source": "„.…. ”"
    }
   ],
   "id": "p024"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p025.s01",
     "source": "„Wil je haar dan niet hebben?”"
    }
   ],
   "id": "p025"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p026.s01",
     "source": "De Dood stond op en velde haar met één slag neêr ; daarna achtervolgde hij heer Spin, dien hij ook tot zich wilde nemen."
    },
    {
     "id": "p026.s02",
     "source": "Deze echter liep veel vlugger, en bereikte zijn huis schreeuwende:"
    }
   ],
   "id": "p026"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p027.s01",
     "source": "„Schuilt!"
    },
    {
     "id": "p027.s02",
     "source": "Daar komt de Dood!”"
    }
   ],
   "id": "p027"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p028.s01",
     "source": "Niemand begreep hem, want de Dood was destijds niet bekend."
    },
    {
     "id": "p028.s02",
     "source": "Heer Spin verschool zich in een beslagruimte, en de Dood trad zijn woning binnen, waar hij zijn gansche gezin neêrvelde."
    }
   ],
   "id": "p028"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p029.s01",
     "source": "Toen de Dood weêr vertrokken was, kwam heer Spin uit zijn schuilplaats te voorschijn en zong hij:"
    }
   ],
   "id": "p029"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p030.s01",
     "source": "Héli kóndre sa sóengoe!"
    }
   ],
   "id": "p030"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p031.s01",
     "source": "Alla soema sa déde!"
    }
   ],
   "id": "p031"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p032.s01",
     "source": "Anansi wawán sa tan!"
    }
   ],
   "id": "p032"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p033.s01",
     "source": "[ ]"
    }
   ],
   "id": "p033"
  }
 ]
}