    }
   ],
   "id": "p001"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p002.s01",
     "source": "A DEER, although toothless, may accomplish something."
    }
   ],
   "id": "p002"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p003.s01",
     "source": "Deceptive appearances."
    }
   ],
   "id": "p003"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p004.s01",
     "source": "He is just now sleeping on a deerskin."
    }
   ],
   "id": "p004"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p005.s01",
     "source": "Comfort now but trouble ahead."
    }
   ],
   "id": "p005"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p006.s01",
     "source": "He wants to die with all his teeth in his head."
    }
   ],
   "id": "p006"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p007.s01",
     "source": "Too reckless to live to old age."
    }
   ],
   "id": "p007"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p008.s01",
     "source": "You think Nass River is always calm."
    }
   ],
   "id": "p008"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p009.s01",
     "source": "Foolhardiness of those who think everything favorable to them."
    },
    {
     "id": "p009.s02",
     "source": "The mouth of the Nass is very rough."
    }
   ],
   "id": "p009"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p010.s01",
     "source": "You mistake the corner of the house for the door."
    }
   ],
   "id": "p010"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p011.s01",
     "source": "A gross blunder."
    }
   ],
   "id": "p011"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p012.s01",
     "source": "What will you eat when the snow is on the north side of the trees?"
    }
   ],
   "id": "p012"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p013.s01",
     "source": "Improvidence."
    },
    {
     "id": "p013.s02",
     "source": "At the end of winter food is always scarce."
    }
   ],
   "id": "p013"
  }
 ]
}