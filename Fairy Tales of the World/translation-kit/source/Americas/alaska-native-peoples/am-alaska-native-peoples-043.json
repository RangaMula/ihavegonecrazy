  {
   "type": "prose",
   "segments": [
    {
     "id": "p002.s01",
     "source": "A LONG time ago fire was seen coming through the air from the north."
    },
    {
     "id": "p002.s02",
     "source": "It looked like a huge animal."
    },
    {
     "id": "p002.s03",
     "source": "Its face was fire."
    },
    {
     "id": "p002.s04",
     "source": "Fire came from its mouth and also from its back."
    },
    {
     "id": "p002.s05",
     "source": "Flames of fire shot from its paws."
    },
    {
     "id": "p002.s06",
     "source": "The Thing, moving backward, thundered through the air."
    }
   ],
   "id": "p002"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p003.s01",
     "source": "In the olden times, these monsters came often."
    },
    {
     "id": "p003.s02",
     "source": "Now they have not been seen for a long time."
    }
   ],
   "id": "p003"
  }
 ]
}