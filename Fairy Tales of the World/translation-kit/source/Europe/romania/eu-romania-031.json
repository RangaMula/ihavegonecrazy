 "markdown_file": "Europe/Romania/031 - The Hart And The Making Of The World.md",
 "stats": {
  "paragraphs": 80,
  "segments": 82,
  "words": 390
 },
 "paragraphs": [
  {
   "type": "prose",
   "segments": [
    {
     "id": "p001.s01",
     "source": "A Christmas Carol."
    }
   ],
   "id": "p001"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p002.s01",
     "source": "Slowly, slowly, O Lord,"
    }
   ],
   "id": "p002"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p003.s01",
     "source": "The little river Olt"
    }
   ],
   "id": "p003"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p004.s01",
     "source": "Has grown big,"
    }
   ],
   "id": "p004"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p005.s01",
     "source": "So big"
    }
   ],
   "id": "p005"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p006.s01",
     "source": "That the borders cannot be seen."
    }
   ],
   "id": "p006"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p007.s01",
     "source": "But what is coming"
    }
   ],
   "id": "p007"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p008.s01",
     "source": "Down the Olt?"
    }
   ],
   "id": "p008"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p009.s01",
     "source": "Tall pines"
    }
   ],
   "id": "p009"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p010.s01",
     "source": "And dry fir trees."
    }
   ],
   "id": "p010"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p011.s01",
     "source": "Among the pines,"
    }
   ],
   "id": "p011"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p012.s01",
     "source": "Among the fir trees,"
    }
   ],
   "id": "p012"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p013.s01",
     "source": "A three-year-old stag"
    }
   ],
   "id": "p013"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p014.s01",
     "source": "Is swimming."
    }
   ],
   "id": "p014"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p015.s01",
     "source": "The stag swims,"
    }
   ],
   "id": "p015"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p016.s01",
     "source": "And lifts up its horns."
    }
   ],
   "id": "p016"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p017.s01",
     "source": "On the top of his horns"
    }
   ],
   "id": "p017"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p018.s01",
     "source": "A cradle is hanging and swinging,"
    }
   ],
   "id": "p018"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p019.s01",
     "source": "A green cradle made of silk,"
    }
   ],
   "id": "p019"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p020.s01",
     "source": "Woven in six strands."
    }
   ],
   "id": "p020"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p021.s01",
     "source": "But who sits in the cradle?"
    }
   ],
   "id": "p021"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p022.s01",
     "source": "The maiden, the young girl,"
    }
   ],
   "id": "p022"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p023.s01",
     "source": "With her tresses hanging down the back,"
    }
   ],
   "id": "p023"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p024.s01",
     "source": "Shining"
    }
   ],
   "id": "p024"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p025.s01",
     "source": "Like the holy sun."
    }
   ],
   "id": "p025"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p026.s01",
     "source": "She sits and sews,"
    }
   ],
   "id": "p026"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p027.s01",
     "source": "And embroiders"
    }
   ],
   "id": "p027"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p028.s01",
     "source": "A collar for her father,"
    }
   ],
   "id": "p028"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p029.s01",
     "source": "A kerchief for her brother."
    }
   ],
   "id": "p029"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p030.s01",
     "source": "But she stops and does not sew,"
    }
   ],
   "id": "p030"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p031.s01",
     "source": "Nor does her mouth keep quiet,"
    }
   ],
   "id": "p031"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p032.s01",
     "source": "For she is singing:"
    }
   ],
   "id": "p032"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p033.s01",
     "source": "“Slowly, slowly,"
    }
   ],
   "id": "p033"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p034.s01",
     "source": "Old stag,"
    }
   ],
   "id": "p034"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p035.s01",
     "source": "Slowly, slowly be thou swimming."
    }
   ],
   "id": "p035"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p036.s01",
     "source": "Do not hinder my work."
    }
   ],
   "id": "p036"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p037.s01",
     "source": "And the waves are rising;"
    }
   ],
   "id": "p037"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p038.s01",
     "source": "They might wash me off and carry me off thy horns."
    }
   ],
   "id": "p038"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p039.s01",
     "source": "Slowly, slowly,"
    }
   ],
   "id": "p039"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p040.s01",
     "source": "Dear old stag,"
    }
   ],
   "id": "p040"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p041.s01",
     "source": "For I have three brothers at court,"
    }
   ],
   "id": "p041"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p042.s01",
     "source": "Where they learn many things."
    }
   ],
   "id": "p042"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p043.s01",
     "source": "All the three are noted hunters,"
    }
   ],
   "id": "p043"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p044.s01",
     "source": "And good falconers."
    }
   ],
   "id": "p044"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p045.s01",
     "source": "They will discover thee,"
    }
   ],
   "id": "p045"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p046.s01",
     "source": "And run after me."
    }
   ],
   "id": "p046"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p047.s01",
     "source": "With their falcons they will pursue thee."
    }
   ],
   "id": "p047"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p048.s01",
     "source": "With their dogs they will worry thee."
    }
   ],
   "id": "p048"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p049.s01",
     "source": "With their lances they will prick thee."
    }
   ],
   "id": "p049"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p050.s01",
     "source": "Slowly, slowly,"
    }
   ],
   "id": "p050"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p051.s01",
     "source": "Dear old stag—"
    }
   ],
   "id": "p051"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p052.s01",
     "source": "For if my brothers find thee,"
    }
   ],
   "id": "p052"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p053.s01",
     "source": "They will make my wedding feast"
    }
   ],
   "id": "p053"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p054.s01",
     "source": "With thy poor flesh."
    }
   ],
   "id": "p054"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p055.s01",
     "source": "With thy bones"
    }
   ],
   "id": "p055"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p056.s01",
     "source": "They will build"
    }
   ],
   "id": "p056"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p057.s01",
     "source": "My little house."
    }
   ],
   "id": "p057"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p058.s01",
     "source": "With thy skin"
    }
   ],
   "id": "p058"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p059.s01",
     "source": "They will cover"
    }
   ],
   "id": "p059"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p060.s01",
     "source": "My little home."
    }
   ],
   "id": "p060"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p061.s01",
     "source": "With thy blood"
    }
   ],
   "id": "p061"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p062.s01",
     "source": "They will paint"
    }
   ],
   "id": "p062"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p063.s01",
     "source": "My little courts."
    }
   ],
   "id": "p063"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p064.s01",
     "source": "And with thy head"
    }
   ],
   "id": "p064"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p065.s01",
     "source": "They will celebrate"
    }
   ],
   "id": "p065"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p066.s01",
     "source": "The holy feast."
    }
   ],
   "id": "p066"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p067.s01",
     "source": "They will place it"
    }
   ],
   "id": "p067"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p068.s01",
     "source": "Over the gate,"
    }
   ],
   "id": "p068"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p069.s01",
     "source": "At the entrance of the little garden."
    }
   ],
   "id": "p069"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p070.s01",
     "source": "Of thy hoofs"
    }
   ],
   "id": "p070"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p071.s01",
     "source": "They will make"
    }
   ],
   "id": "p071"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p072.s01",
     "source": "Crystal cups,"
    }
   ],
   "id": "p072"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p073.s01",
     "source": "Out of which"
    }
   ],
   "id": "p073"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p074.s01",
     "source": "Nobles drink."
    }
   ],
   "id": "p074"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p075.s01",
     "source": "On rare occasions—"
    }
   ],
   "id": "p075"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p076.s01",
     "source": "On Christmas day and Epiphany—"
    }
   ],
   "id": "p076"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p077.s01",
     "source": "When the whole world rejoices,"
    }
   ],
   "id": "p077"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p078.s01",
     "source": "I drink to the health of these houses"
    }
   ],
   "id": "p078"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p079.s01",
     "source": "For many years."
    }
   ],
   "id": "p079"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p080.s01",
     "source": "The mythical stag carrying on his horns a girl who is like the sun is similar to the bull of Mithras and to the bull in the Avesta, out of which the world was created."
    },
    {
     "id": "p080.s02",
     "source": "The stag provides here all the elements for the building of a house and for the merriment of the nobles."
    },
    {
     "id": "p080.s03",
     "source": "Each part of its body is accounted for."
    }
   ],
   "id": "p080"
  }
 ]
}