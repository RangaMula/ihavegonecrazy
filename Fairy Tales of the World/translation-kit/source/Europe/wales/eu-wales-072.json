{
 "id": "eu-wales-072",
 "title": {
  "id": "title",
  "source": "Satan appearing to a Collier"
 },
 "tradition": "Wales",
 "continent": "Europe",
 "source_lang": "en",
 "source_book": "Welsh Folk-Lore",
 "credits": "Owen, Elias (author, d. 1899)",
 "gutenberg": "Project Gutenberg eBook #20096 — https://www.gutenberg.org/ebooks/20096 (copied via the GITenberg mirror)",
 "copyright": "Public domain worldwide: the text was published long ago and every named author/translator died in or before 1955.",
 "markdown_file": "Europe/Wales/072 - Satan appearing to a Collier.md",
 "stats": {
  "paragraphs": 136,
