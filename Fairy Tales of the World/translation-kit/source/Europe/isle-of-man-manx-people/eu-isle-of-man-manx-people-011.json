 "paragraphs": [
  {
   "type": "prose",
   "segments": [
    {
     "id": "p001.s01",
     "source": "The Fynoderee went to the meadow"
    }
   ],
   "id": "p001"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p002.s01",
     "source": "To lift the dew at grey cock crow,"
    }
   ],
   "id": "p002"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p003.s01",
     "source": "The maiden hair and the cow herb"
    }
   ],
   "id": "p003"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p004.s01",
     "source": "He was stamping them both his feet under;"
    }
   ],
   "id": "p004"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p005.s01",
     "source": "He was stretching himself on the meadow,"
    }
   ],
   "id": "p005"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p006.s01",
     "source": "He threw the grass on the left hand;"
    }
   ],
   "id": "p006"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p007.s01",
     "source": "Last year he caused us to wonder,"
    }
   ],
   "id": "p007"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p008.s01",
     "source": "This year he’s doing far better."
    }
   ],
   "id": "p008"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p009.s01",
     "source": "He was stretching himself on the meadow,"
    }
   ],
   "id": "p009"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p010.s01",
     "source": "The herbs in bloom he was cutting,"
    }
   ],
   "id": "p010"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p011.s01",
     "source": "The bog bean herb in the curragh,"
    }
   ],
   "id": "p011"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p012.s01",
     "source": "As he went on his way it was shaking,"
    }
   ],
   "id": "p012"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p013.s01",
     "source": "Everything with his scythe he was cutting,"
    }
   ],
   "id": "p013"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p014.s01",
     "source": "To sods was skinning the meadows,"
    }
   ],
   "id": "p014"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p015.s01",
     "source": "And if a leaf were left standing,"
    }
   ],
   "id": "p015"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p016.s01",
     "source": "With his heels he was stamping it under."
    }
   ],
   "id": "p016"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p017.s01",
     "source": "Old Song."
    }
   ],
   "id": "p017"
  }
 ]
}