    {
     "id": "p011.s01",
     "source": "Hans takes Gretel, ties her to a rope, leads her to the rack, and binds her fast."
    },
    {
     "id": "p011.s02",
     "source": "Then Hans goes to his mother."
    },
    {
     "id": "p011.s03",
     "source": "‘Good evening, mother.’"
    },
    {
     "id": "p011.s04",
     "source": "‘Good evening, Hans."
    },
    {
     "id": "p011.s05",
     "source": "Where have you been?’"
    },
    {
     "id": "p011.s06",
     "source": "‘With Gretel.’"
    },
    {
     "id": "p011.s07",
     "source": "‘What did you take her?’"
    },
    {
     "id": "p011.s08",
     "source": "‘I took her nothing.’"
    },
    {
     "id": "p011.s09",
     "source": "‘What did Gretel give you?’"
    },
    {
     "id": "p011.s10",
     "source": "‘She gave me nothing, she came with me.’"
    },
    {
     "id": "p011.s11",
     "source": "‘Where have you left Gretel?’"
    },
    {
     "id": "p011.s12",
     "source": "‘I led her by the rope, tied her to the rack, and scattered some grass for her.’"
    },
    {
     "id": "p011.s13",
     "source": "‘That was ill done, Hans, you should have cast friendly eyes on her.’"
    },
    {
     "id": "p011.s14",
     "source": "‘Never mind, will do better.’"
    }
   ],
   "id": "p011"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p012.s01",
     "source": "Hans went into the stable, cut out all the calves’ and sheep’s eyes, and threw them in Gretel’s face."
    },
    {
     "id": "p012.s02",
     "source": "Then Gretel became angry, tore herself loose and ran away, and was no longer the bride of Hans."
    }
