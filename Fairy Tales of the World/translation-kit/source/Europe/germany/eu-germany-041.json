    {
     "id": "p006.s01",
     "source": "Hans takes the bacon, ties it to a rope, and drags it away behind him."
    },
    {
     "id": "p006.s02",
     "source": "The dogs come and devour the bacon."
    },
    {
     "id": "p006.s03",
     "source": "When he gets home, he has the rope in his hand, and there is no longer anything hanging on to it."
    },
    {
     "id": "p006.s04",
     "source": "‘Good evening, mother.’"
    },
    {
     "id": "p006.s05",
     "source": "‘Good evening, Hans."
