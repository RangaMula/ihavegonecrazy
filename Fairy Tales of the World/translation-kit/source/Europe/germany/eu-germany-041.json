   "type": "prose",
   "segments": [
    {
     "id": "p001.s01",
     "source": "The mother of Hans said: ‘Whither away, Hans?’"
    },
    {
     "id": "p001.s02",
     "source": "Hans answered: ‘To Gretel.’"
    },
    {
     "id": "p001.s03",
     "source": "‘Behave well, Hans.’"
    },
    {
     "id": "p001.s04",
     "source": "‘Oh, I’ll behave well."
    },
    {
     "id": "p001.s05",
     "source": "Goodbye, mother.’"
    },
    {
     "id": "p001.s06",
     "source": "‘Goodbye, Hans.’"
    },
    {
     "id": "p001.s07",
     "source": "Hans comes to Gretel."
    },
    {
     "id": "p001.s08",
     "source": "‘Good day, Gretel.’"
    },
    {
     "id": "p001.s09",
     "source": "‘Good day, Hans."
    },
    {
     "id": "p001.s10",
     "source": "What do you bring that is good?’"
    },
    {
     "id": "p001.s11",
     "source": "‘I bring nothing, I want to have something given me.’"
    },
    {
     "id": "p001.s12",
     "source": "Gretel presents Hans with a needle, Hans says: ‘Goodbye, Gretel.’"
    },
    {
     "id": "p001.s13",
     "source": "‘Goodbye, Hans.’"
    }
   ],
   "id": "p001"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p002.s01",
     "source": "Hans takes the needle, sticks it into a hay-cart, and follows the cart home."
    },
    {
     "id": "p002.s02",
     "source": "‘Good evening, mother.’"
    },
    {
     "id": "p002.s03",
     "source": "‘Good evening, Hans."
    },
    {
     "id": "p002.s04",
     "source": "Where have you been?’"
    },
    {
     "id": "p002.s05",
     "source": "‘With Gretel.’"
    },
    {
     "id": "p002.s06",
     "source": "‘What did you take her?’"
    },
    {
     "id": "p002.s07",
     "source": "‘Took nothing; had something given me.’"
    },
    {
     "id": "p002.s08",
     "source": "‘What did Gretel give you?’"
    },
    {
     "id": "p002.s09",
     "source": "‘Gave me a needle.’"
    },
    {
     "id": "p002.s10",
     "source": "‘Where is the needle, Hans?’"
    },
    {
     "id": "p002.s11",
     "source": "‘Stuck in the hay-cart.’"
    },
    {
     "id": "p002.s12",
     "source": "‘That was ill done, Hans."
    },
    {
     "id": "p002.s13",
     "source": "You should have stuck the needle in your sleeve.’"
    },
    {
     "id": "p002.s14",
     "source": "‘Never mind, I’ll do better next time.’"
    }
   ],
