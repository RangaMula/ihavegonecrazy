  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p292.s01",
     "source": "THE DULLAHAN."
    }
   ],
   "id": "p292"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p293.s01",
     "source": "\"Then wonder not at headless folk , Since every day you greet 'em; Nor treat old stories as a joke, When fools you daily meet 'em.\""
    }
   ],
   "id": "p293"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p294.s01",
     "source": "— The Legendary."
    }
   ],
   "id": "p294"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p295.s01",
     "source": "\"Says the friar, 'tis strange headless horses should trot.\""
    }
   ],
   "id": "p295"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p296.s01",
     "source": "Old Song."
    }
   ],
   "id": "p296"
