    {
     "id": "p002.s01",
     "source": "[Coloony is a few miles south of the town of Sligo."
    },
    {
     "id": "p002.s02",
     "source": "Father O'Hart lived there in the last century, and was greatly beloved."
    },
    {
     "id": "p002.s03",
     "source": "These lines accurately record the tradition."
    },
    {
     "id": "p002.s04",
     "source": "No one who has held the stolen land has prospered."
    },
    {
     "id": "p002.s05",
     "source": "It has changed owners many times.]"
    }
   ],
