   "segments": [
    {
     "id": "p001.s01",
     "source": "Zamani dunia ilikuwa mpya."
    }
   ],
   "id": "p001"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p002.s01",
     "source": "Milima ilifunika ulimwengu kama blanketi."
    }
   ],
   "id": "p002"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p003.s01",
     "source": "Dunia ilikuwa na dimbwi kubwa."
    }
   ],
   "id": "p003"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p004.s01",
     "source": "Lilikuwa na maji baridi yaliyotulia."
    }
   ],
   "id": "p004"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p005.s01",
     "source": "Nyoka wawili waliishi kwenye dimbwi."
    }
   ],
   "id": "p005"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p006.s01",
     "source": "Mmoja mwenye nguvu, mwingine dhaifu."
    }
   ],
   "id": "p006"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p007.s01",
     "source": "Siku moja radi ilipiga."
    }
   ],
   "id": "p007"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p008.s01",
     "source": "Nyoka wakaona ardhi na vitu tofauti."
    }
   ],
   "id": "p008"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p009.s01",
     "source": "Wakaamua kwenda kuishi kwenye ardhi."
    }
   ],
   "id": "p009"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p010.s01",
     "source": "Wakajikunjua wakaogelea."
    }
   ],
   "id": "p010"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p011.s01",
     "source": "Wakaelekea kwenye mwangaza."
    }
   ],
   "id": "p011"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p012.s01",
     "source": "Mikia yao ikagawika wakawa na miguu."
    }
   ],
   "id": "p012"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p013.s01",
     "source": "Wakapata pia mikono na vidole."
    }
   ],
   "id": "p013"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p014.s01",
     "source": "Wakageuka wakawa mume na mke."
    }
   ],
   "id": "p014"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p015.s01",
     "source": "Wakatazamana, wakapendana."
    }
   ],
   "id": "p015"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p016.s01",
     "source": "Wakaamua kulinda wanyama na mimea."
    }
   ],
   "id": "p016"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p017.s01",
     "source": "Wakafurahia jua."
    }
   ],
   "id": "p017"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p018.s01",
     "source": "Wakashikana mikono."
    }
   ],
   "id": "p018"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p019.s01",
     "source": "Wakatembea pamoja kwenye ulimwengu wao mpya."
    }
   ],
   "id": "p019"
  }
 ]
