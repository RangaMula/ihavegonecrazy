 "paragraphs": [
  {
   "type": "prose",
   "segments": [
    {
     "id": "p001.s01",
     "source": "Kudala, kwakuhlala usapho olonwabileyo."
    }
   ],
   "id": "p001"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p002.s01",
     "source": "Abazange balwe omnye nomnye."
    },
    {
     "id": "p002.s02",
     "source": "Babebanceda abazali babo ekhaya nasemasimini."
    }
   ],
   "id": "p002"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p003.s01",
     "source": "Kodwa babengavume-lekanga ukuba basondele emlilweni."
    }
   ],
   "id": "p003"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p004.s01",
     "source": "Kwakufuneka benze wonke umsebenzi wabo ebusuku."
    }
   ],
   "id": "p004"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p005.s01",
     "source": "Kodwa omnye wamakhwenkwe wayelangazelela ukuphuma phandle elangeni."
    }
   ],
   "id": "p005"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p006.s01",
     "source": "Ngenye imini ulangazelelo lwakhula ngamandla."
    },
    {
     "id": "p006.s02",
     "source": "Abantakwabo bamlumkisa."
    }
   ],
   "id": "p006"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p007.s01",
     "source": "Kodwa kwaku semva kwexesha!"
    },
    {
     "id": "p007.s02",
     "source": "Wanyibilika elangeni elishushu."
    }
   ],
   "id": "p007"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p008.s01",
     "source": "Abantwana bekhandlela baba lusizi kakhulu ukubona untakwabo enyibilike waphela."
    }
   ],
   "id": "p008"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p009.s01",
     "source": "Kodwa, benza icebo."
    },
    {
     "id": "p009.s02",
     "source": "Babumba igaqa lekhandlela laba yintaka."
    }
   ],
   "id": "p009"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p010.s01",
     "source": "Bathatha umntakwabo oyintaka, bamsa phezu kwentaba ephakamileyo."
    }
   ],
   "id": "p010"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p011.s01",
     "source": "Njengoko ilanga liphuma, wabhabhela kude evuma kukukhanya kwakusasa."
    }
   ],
   "id": "p011"
  }
 ]
}