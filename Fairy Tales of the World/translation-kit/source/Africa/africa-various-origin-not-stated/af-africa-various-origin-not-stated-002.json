 "paragraphs": [
  {
   "type": "prose",
   "segments": [
    {
     "id": "p001.s01",
     "source": "Elephant and Hare were good friends."
    }
   ],
   "id": "p001"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p002.s01",
     "source": "They found grass and water for their animals."
    }
   ],
   "id": "p002"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p003.s01",
     "source": "They liked to play football."
    }
   ],
   "id": "p003"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p004.s01",
     "source": "Elephant scored more goals."
    }
   ],
   "id": "p004"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p005.s01",
     "source": "Hare was not happy."
    }
   ],
   "id": "p005"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p006.s01",
     "source": "Hare asked Elephant, \"What makes you a good player?\""
    }
   ],
   "id": "p006"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p007.s01",
     "source": "\"My big legs.\""
    }
   ],
   "id": "p007"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p008.s01",
     "source": "Hare and Elephant ran a race."
    }
   ],
   "id": "p008"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p009.s01",
     "source": "Hare won."
    }
   ],
   "id": "p009"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p010.s01",
     "source": "Elephant asked Hare, \"What makes you a good runner?\""
    }
   ],
   "id": "p010"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p011.s01",
     "source": "\"My thin legs.\""
    }
   ],
   "id": "p011"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p012.s01",
     "source": "Elephant asked, \"How can I get thin legs?\""
    }
   ],
   "id": "p012"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p013.s01",
     "source": "\"I will show you how.\""
    }
   ],
   "id": "p013"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p014.s01",
     "source": "Hare said, \"Stand in the fire.\""
    }
   ],
   "id": "p014"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p015.s01",
     "source": "Elephant did."
    },
    {
     "id": "p015.s02",
     "source": "He cried, \"I am burning!\""
    }
   ],
   "id": "p015"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p016.s01",
     "source": "Hare told Elephant, \"This is the only way your legs can become thin.\""
    }
   ],
   "id": "p016"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p017.s01",
     "source": "Elephant moved out of the fire."
    }
   ],
   "id": "p017"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p018.s01",
     "source": "He lay down."
    }
   ],
   "id": "p018"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p019.s01",
     "source": "For many days, Elephant was not able to stand."
    }
   ],
   "id": "p019"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p020.s01",
     "source": "When he was better, he walked home to his family."
    }
   ],
   "id": "p020"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p021.s01",
     "source": "Hare was very sorry."
    },
    {
     "id": "p021.s02",
     "source": "He asked Elephant to forgive him."
    }
   ],
   "id": "p021"
  }
 ]
}