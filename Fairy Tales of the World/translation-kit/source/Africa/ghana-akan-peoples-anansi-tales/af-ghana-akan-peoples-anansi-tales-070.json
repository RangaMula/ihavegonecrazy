 "paragraphs": [
  {
   "type": "prose",
   "segments": [
    {
     "id": "p001.s01",
     "source": "Uyakuthanda ukudla, kodwa uyavilapha ukukupheka."
    }
   ],
   "id": "p001"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p002.s01",
     "source": "\"Kulungile ngizokupha."
    },
    {
     "id": "p002.s02",
     "source": "Ngisize ngokugoqoza.\""
    }
   ],
   "id": "p002"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p003.s01",
     "source": "Kodwa u-Anansi uyavilapha."
    }
   ],
   "id": "p003"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p004.s01",
     "source": "U-Anansi athandele ulwembu emlenzeni wakhe, nasebhodweni likaGwajo."
    }
   ],
   "id": "p004"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p005.s01",
     "source": "\"We zinkawu, ngicela ningiphe ubhontshisi wenu?\" kucela u-Anansi."
    }
   ],
   "id": "p005"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p006.s01",
     "source": "\"Kulungile."
    },
    {
     "id": "p006.s02",
     "source": "Sisize ukuqoba.\""
    }
   ],
   "id": "p006"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p007.s01",
     "source": "\"Ndlovudawana, ngicela ukuzwa amazambane akho?\""
    }
   ],
   "id": "p007"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p008.s01",
     "source": "\"Kulungile."
    },
    {
     "id": "p008.s02",
     "source": "Ngisize siwalungise.\""
    }
   ],
   "id": "p008"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p009.s01",
     "source": "Ngokushesha, yilowo nalowo mlenze ka-Anansi wabe uthandeleke ebhodweni."
    }
   ],
   "id": "p009"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p010.s01",
     "source": "Yonke imilenze eyisishiyagalombili yadonseka."
    }
   ],
   "id": "p010"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p011.s01",
     "source": "\"Musani ukudonsa!\" kukhala u-Anansi."
    }
   ],
   "id": "p011"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p012.s01",
     "source": "Imilenze ka-Anansi yadonseka, yadonseka."
    }
   ],
   "id": "p012"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p013.s01",
     "source": "Kungakho nje zonke izicabucabu zinemilenze emide eyondile."
    }
   ],
   "id": "p013"
  }
 ]
}