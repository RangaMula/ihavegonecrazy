 "paragraphs": [
  {
   "type": "prose",
   "segments": [
    {
     "id": "p001.s01",
     "source": "Mbughimbughi na Kwaru wideka wughenyi."
    }
   ],
   "id": "p001"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p002.s01",
     "source": "Mbughimbughi odembonia Kwaru iriso."
    }
   ],
   "id": "p002"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p003.s01",
     "source": "Mbughimbughi idewusa mbuwa ya Kwaru."
    }
   ],
   "id": "p003"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p004.s01",
     "source": "Ukawinga Kwaru."
    }
   ],
   "id": "p004"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p005.s01",
     "source": "Mbughimbughi ideuza vindo vose."
    }
   ],
   "id": "p005"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p006.s01",
     "source": "Idepata magome mengi."
    }
   ],
   "id": "p006"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p007.s01",
     "source": "Mbughimbughi ideduka kidasi chongo ikaenda muzinyi."
    }
   ],
   "id": "p007"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p008.s01",
     "source": "Mbughimbughi ikaduwa kidasi andonyi."
    }
   ],
   "id": "p008"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p009.s01",
     "source": "Ikaenda kujivisa isenyelo ni vua."
    }
   ],
   "id": "p009"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p010.s01",
     "source": "Vua endanya machi ghikachuwa."
    }
   ],
   "id": "p010"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p011.s01",
     "source": "Mbughimbughi ikajiwisa ilangenyi."
    }
   ],
   "id": "p011"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p012.s01",
     "source": "Nyonyi ikawona kidasi na ikachifunikira na mawawa ghake."
    }
   ],
   "id": "p012"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p013.s01",
     "source": "\"Ichi kidasi ni chapo,\" Nyonyi ikaghora."
    }
   ],
   "id": "p013"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p014.s01",
     "source": "\"Ni chapo!\""
    },
    {
     "id": "p014.s02",
     "source": "Mbughimbughi ikaboka."
    }
   ],
   "id": "p014"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p015.s01",
     "source": "Nyonyi kaghora, \"Ndekua magome na mabemba ghisefinikirilo.\""
    }
   ],
   "id": "p015"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p016.s01",
     "source": "Chifu na waghosi wikadwa ngelo kubonya wuamuzi nani okoghe na wuloli."
    }
   ],
   "id": "p016"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p017.s01",
     "source": "Kutuwa, wikaghora, \"Nyonyi ni muloli."
    },
    {
     "id": "p017.s02",
     "source": "Kidasi ni chake.\""
    }
   ],
   "id": "p017"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p018.s01",
     "source": "Kwaru ukwawuya mbuwenyi yake."
    }
   ],
   "id": "p018"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p019.s01",
     "source": "Mbughimbughi ukakaiya ndowine magome, angu waghenyi."
    }
   ],
   "id": "p019"
  }
 ]
}