 "paragraphs": [
  {
   "type": "prose",
   "segments": [
    {
     "id": "p001.s01",
     "source": "Anansi and Rabbit were friends."
    }
   ],
   "id": "p001"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p002.s01",
     "source": "Anansi was jealous of Rabbit's wealth."
    }
   ],
   "id": "p002"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p003.s01",
     "source": "Anansi took over Rabbit’s farm."
    }
   ],
   "id": "p003"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p004.s01",
     "source": "He chased away Rabbit."
    }
   ],
   "id": "p004"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p005.s01",
     "source": "Anansi sold all the crops."
    }
   ],
   "id": "p005"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p006.s01",
     "source": "He got a lot of money."
    }
   ],
   "id": "p006"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p007.s01",
     "source": "Anansi went home carrying his basket on his head."
    }
   ],
   "id": "p007"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p008.s01",
     "source": "Anansi put the basket down."
    }
   ],
   "id": "p008"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p009.s01",
     "source": "He went to shelter from the rain."
    }
   ],
   "id": "p009"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p010.s01",
     "source": "The rain caused flooding, so Anansi hid in a hole."
    }
   ],
   "id": "p010"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p011.s01",
     "source": "Vulture saw the basket and covered it with his wings."
    }
   ],
   "id": "p011"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p012.s01",
     "source": "“This basket is mine,â€ said Vulture."
    }
   ],
   "id": "p012"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p013.s01",
     "source": "\"It is mine!\" shouted Anansi."
    }
   ],
   "id": "p013"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p014.s01",
     "source": "Vulture said, \"I found money and maize unprotected.\""
    }
   ],
   "id": "p014"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p015.s01",
     "source": "The chief and his elders took time to decide who was right."
    }
   ],
   "id": "p015"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p016.s01",
     "source": "Finally, they said, \"Vulture is right."
    },
    {
     "id": "p016.s02",
     "source": "The basket is his.\""
    }
   ],
   "id": "p016"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p017.s01",
     "source": "Rabbit returned to his farm."
    }
   ],
   "id": "p017"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p018.s01",
     "source": "Anansi had no money, or friends."
    }
   ],
   "id": "p018"
  }
 ]
}