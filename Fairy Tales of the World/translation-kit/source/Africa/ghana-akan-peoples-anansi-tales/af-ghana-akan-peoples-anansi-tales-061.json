 "paragraphs": [
  {
   "type": "prose",
   "segments": [
    {
     "id": "p001.s01",
     "source": "Ayenda okulya, aye munafu okufumba."
    }
   ],
   "id": "p001"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p002.s01",
     "source": "Wakamyu yakoba, \"Iyi."
    },
    {
     "id": "p002.s02",
     "source": "Nnhambaku no okukuyugamu.\""
    }
   ],
   "id": "p002"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p003.s01",
     "source": "Aye Munansi munafu."
    }
   ],
   "id": "p003"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p004.s01",
     "source": "Munansi yasiba empumbi okwetoolooza ku bigere bye ni ku nsaka ya Wakamyu."
    }
   ],
   "id": "p004"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p005.s01",
     "source": "\"Nsobola okulya ku bidhandhaali byaimwe?\""
    }
   ],
   "id": "p005"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p006.s01",
     "source": "\"Iyi."
    },
    {
     "id": "p006.s02",
     "source": "Tuyambeku no okwasaaga.\""
    }
   ],
   "id": "p006"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p007.s01",
     "source": "\"Wambiidhi, nsobola okugabana ku mbooli dho?\""
    }
   ],
   "id": "p007"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p008.s01",
     "source": "\"Iyi."
    },
    {
     "id": "p008.s02",
     "source": "Nnhambaku okusosola.\""
    }
   ],
   "id": "p008"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p009.s01",
     "source": "Okwikaikana, nga buli mugulu gwa Munansi musibe ku nsaka."
    }
   ],
   "id": "p009"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p010.s01",
     "source": "Amagulu gonagoona 8 gali kusikibwa!"
    }
   ],
   "id": "p010"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p011.s01",
     "source": "\"Leka kusikula!\""
    },
    {
     "id": "p011.s02",
     "source": "Munansi yalira."
    }
   ],
   "id": "p011"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p012.s01",
     "source": "Amagulu ge gadhuumwiike!"
    }
   ],
   "id": "p012"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p013.s01",
     "source": "Era batyo ba nawumbuli bali na bugulu butono."
    }
   ],
   "id": "p013"
  }
 ]
}