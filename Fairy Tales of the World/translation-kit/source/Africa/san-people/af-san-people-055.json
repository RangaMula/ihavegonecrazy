  {
   "type": "prose",
   "segments": [
    {
     "id": "p003.s01",
     "source": "Hier word natuurlik die kameelperd bedoel, wat die geleerdes giraf noem."
    },
    {
     "id": "p003.s02",
     "source": "Baie van die reëls en parte word oor en oor herhaal, daar Boesman-gedigte nie ’n groot verskeidenheid oplewer nie."
    },
    {
     "id": "p003.s03",
     "source": "Die nabootsings is moeilik op papier terug te gee."
    },
    {
     "id": "p003.s04",
     "source": "Onder ramkie- en tamboerspel lui die dans as volg:—"
    }
   ],
   "id": "p003"
  },
  {
