   ],
   "id": "p001"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p002.s01",
     "source": "I. Nkunga u Vwoka E tala vwoka, tusisa beto."
    },
    {
     "id": "p002.s02",
     "source": "Yay’e!"
    },
    {
     "id": "p002.s03",
     "source": "E mvuku magata utusukidi kueto!"
    },
    {
     "id": "p002.s04",
     "source": "E, e!"
    },
    {
     "id": "p002.s05",
     "source": "E, e!"
    },
    {
     "id": "p002.s06",
     "source": "Bele."
    },
    {
     "id": "p002.s07",
     "source": "Yay’e!"
    },
    {
     "id": "p002.s08",
     "source": "E tala yandi e!"
    },
    {
     "id": "p002.s09",
     "source": "E, e!"
    },
    {
     "id": "p002.s10",
     "source": "In al de dorpen. [ ] I. Lied over de verlaten Dorpen He, zie de dorpen, die wij verlaten hebben."
    },
    {
     "id": "p002.s11",
     "source": "He, oude!"
    },
    {
     "id": "p002.s12",
     "source": "He, de vereeniging der dorpen heeft ons doen uitsterven!"
    },
    {
     "id": "p002.s13",
     "source": "He, he!"
    },
    {
     "id": "p002.s14",
     "source": "He, he!"
    },
    {
     "id": "p002.s15",
     "source": "Zij zijn verdwenen."
    },
    {
     "id": "p002.s16",
     "source": "He, oude!"
    },
    {
     "id": "p002.s17",
     "source": "He, zie ons verlaten dorp!"
    },
    {
     "id": "p002.s18",
     "source": "He, he!"
    },
    {
     "id": "p002.s19",
     "source": "In al de dorpen. [ ]"
    }
   ],
   "id": "p002"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p003.s01",
     "source": "II."
    },
    {
     "id": "p003.s02",
     "source": "Nkunga u Bula-Matari E mbembo Ya Bul’e, Mbari Ya boy e!"
    },
    {
     "id": "p003.s03",
     "source": "Bio bivwete nsalaba Ya Bula-Matari e!"
    },
    {
     "id": "p003.s04",
     "source": "Ya boy e!"
    },
    {
     "id": "p003.s05",
     "source": "In al de dorpen."
    },
    {
     "id": "p003.s06",
     "source": "II."
    },
    {
     "id": "p003.s07",
     "source": "Lied over den Staat Het is ter oorzake van Heer Staat, He, mijn beste jongens!"
    },
    {
     "id": "p003.s08",
     "source": "Dat men nu die stoffen van Heer Staat draagt!"
    },
    {
     "id": "p003.s09",
     "source": "He, jongens!"
    },
    {
     "id": "p003.s10",
     "source": "In al de dorpen."
    }
   ],
   "id": "p003"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p004.s01",
     "source": "III."
    },
    {
     "id": "p004.s02",
     "source": "Nkunga u Bieya Na Nkanza kitambala mpamb’e!"
    },
    {
     "id": "p004.s03",
     "source": "Ma Nsansi balenga niangi."
    },
    {
     "id": "p004.s04",
     "source": "Na Nkanza, kisiwu kilweke, Mbulu k’alenda yo ko."
    },
    {
     "id": "p004.s05",
     "source": "Ma Laba, kisiwu kilweke, Ta Nloko, mbulu k’alenda yo ko."
    },
    {
     "id": "p004.s06",
     "source": "Kisantu. [ ] III."
    },
    {
     "id": "p004.s07",
     "source": "Spotlied Heer Nkanza, hij heeft nog geen stuk vod!"
    },
    {
     "id": "p004.s08",
     "source": "Zijn vrouw Nsansi gaat met hem wandelen, droevig en droevig."
    },
    {
     "id": "p004.s09",
     "source": "Heer Nkanza, ’t droog seizoen komt aan !"
    },
    {
     "id": "p004.s10",
     "source": "Een beddedeken kan hij niet koopen."
    },
    {
     "id": "p004.s11",
     "source": "Mevrouw Laba, ’t droog seizoen komt aan, Uw man Nloko kan nog geen beddedeken koopen."
    },
    {
     "id": "p004.s12",
     "source": "Kisantu. [ ]"
    }
   ],
   "id": "p004"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p005.s01",
     "source": "IV."
    },
    {
     "id": "p005.s02",
     "source": "Nkunga u Bieya Bo bayenda ku Kisantu, bana mfitu babaka."
    },
    {
     "id": "p005.s03",
     "source": "Ta Nyala mfitu k’abaki ko."
    },
    {
     "id": "p005.s04",
     "source": "Yay’e!"
    },
    {
     "id": "p005.s05",
     "source": "Kitambala mpamb’e!"
    },
    {
     "id": "p005.s06",
     "source": "Mba Ya Zwedi e!"
    },
    {
     "id": "p005.s07",
     "source": "Kinanga."
    },
    {
     "id": "p005.s08",
     "source": "IV."
    },
    {
     "id": "p005.s09",
     "source": "Spotlied Die naar Kisantu gaan werken, krijgen hun loon."
    },
    {
     "id": "p005.s10",
     "source": "Maar Heer Nyala, zijn loon, hij krijgt hem niet."
    },
    {
     "id": "p005.s11",
     "source": "He, oude!"
    },
    {
     "id": "p005.s12",
     "source": "Nog geen stuk vod!"
    },
    {
     "id": "p005.s13",
     "source": "He, zijn lieve vrouw Zwedi!"
    },
    {
     "id": "p005.s14",
     "source": "Kinanga."
    }
   ],
   "id": "p005"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p006.s01",
     "source": "V. Nkunga u Mbembo E muana fwidi e!"
    },
    {
     "id": "p006.s02",
     "source": "Mono isidi ye kinsiona muna gata."
    },
    {
     "id": "p006.s03",
     "source": "E ngwa, mono mam’e!"
    },
    {
     "id": "p006.s04",
     "source": "E, e!"
    },
    {
     "id": "p006.s05",
     "source": "E, e!"
    },
    {
     "id": "p006.s06",
     "source": "Toto-Lembolo. [ ] V. Doodenzang Ach, mijn kind is gestorven!"
    },
    {
     "id": "p006.s07",
     "source": "Ik blijf nu een wees in ’t dorp!"
    },
    {
     "id": "p006.s08",
     "source": "He, moeder!"
    },
    {
     "id": "p006.s09",
     "source": "Ik, zijn moeder!"
    },
    {
     "id": "p006.s10",
     "source": "He, he!"
    },
    {
     "id": "p006.s11",
     "source": "He, he!"
    },
    {
     "id": "p006.s12",
     "source": "Toto-Lembolo. [ ]"
    }
   ],
   "id": "p006"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p007.s01",
     "source": "VI."
    },
    {
     "id": "p007.s02",
     "source": "Nkunga u Nganga-nkisi VI."
    },
    {
     "id": "p007.s03",
     "source": "Lied van den Toovenaar a) Ku Toto iyenda."
    },
    {
     "id": "p007.s04",
     "source": "Mbundu yandi bunganga."
    },
    {
     "id": "p007.s05",
     "source": "Kisantu. a) Naar Toto ben ik gegaan."
    },
    {
     "id": "p007.s06",
     "source": "Zijn hart is in ’t toovermiddel."
    },
    {
     "id": "p007.s07",
     "source": "Kisantu. b) E mama!"
    },
    {
     "id": "p007.s08",
     "source": "Mbundu kuna kiteko batekila masa!"
    },
    {
     "id": "p007.s09",
     "source": "E mama!"
    },
    {
     "id": "p007.s10",
     "source": "Muna kitadi kikumbanga."
    },
    {
     "id": "p007.s11",
     "source": "Kilemfu. [ ] b) He mama!"
    },
    {
     "id": "p007.s12",
     "source": "Mijn hart is aan de bron, waar men water put!"
    },
    {
     "id": "p007.s13",
     "source": "He mama!"
    },
    {
     "id": "p007.s14",
     "source": "Waar het water aan ’t bruischen is over de steenen."
    },
    {
     "id": "p007.s15",
     "source": "Kilemfu. [ ]"
    }
   ],
   "id": "p007"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p008.s01",
     "source": "VII."
    },
    {
     "id": "p008.s02",
     "source": "Nkunga u Nsaka VII."
    },
    {
     "id": "p008.s03",
     "source": "Lied onder ’t Spel a) Mono k’isakana ko!"
    },
    {
     "id": "p008.s04",
     "source": "Lunota kongo, dituka tija!"
    },
    {
     "id": "p008.s05",
     "source": "Mono k’isakana ko!"
    },
    {
     "id": "p008.s06",
     "source": "Kisantu. a) Ik, ik speel niet!"
    },
    {
     "id": "p008.s07",
     "source": "Gij, danst en springt, dat het zweet u afloopt."
    },
    {
     "id": "p008.s08",
     "source": "Ik, ik speel niet!"
    },
    {
     "id": "p008.s09",
     "source": "Kisantu. b) Bankwa nkele, lukala ye ngangu: Bana bele!"
    },
    {
     "id": "p008.s10",
     "source": "In alle dorpen van Neder-Kongo. b) Gij, die een geweer hebt, weest verstandig: De kinderen zijn opgetrokken."
    },
    {
     "id": "p008.s11",
     "source": "In alle dorpen van Neder-Kongo. c) Yaba iyaba dia zanga, Ka dia ka disuki."
    },
    {
     "id": "p008.s12",
     "source": "Yaba, Yaya, Iyaba!"
    },
    {
     "id": "p008.s13",
     "source": "Boko di Kinkoni. c) Ruimen, ik ruim dien vijver, Hij, hij wordt niet ledig."
    },
    {
     "id": "p008.s14",
     "source": "He, mijn beste, ruimen ik ruim!"
    },
    {
     "id": "p008.s15",
     "source": "Boko di Kinkoni. d) Kinza-nza-nza!"
    },
    {
     "id": "p008.s16",
     "source": "E mbambi, yaya lukaya."
    },
    {
     "id": "p008.s17",
     "source": "Mayidi. [ ] d) Kinza-nza-nza!"
    },
    {
     "id": "p008.s18",
     "source": "He toovermiddel, mijn beste blad!"
    },
    {
     "id": "p008.s19",
     "source": "Mayidi. [ ]"
    }
   ],
   "id": "p008"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p009.s01",
     "source": "VIII."
    },
    {
     "id": "p009.s02",
     "source": "Nkunga u Bidilu VIII."
    },
    {
     "id": "p009.s03",
     "source": "Treurlied a) Kindengele, kindengele, kindengele!"
    },
    {
     "id": "p009.s04",
     "source": "Ya Zwina!"
    },
    {
     "id": "p009.s05",
     "source": "Kindengele, kindengele, kindengele!"
    },
    {
     "id": "p009.s06",
     "source": "Mono bu ifwila Ya Zwina."
    },
    {
     "id": "p009.s07",
     "source": "Mbengo. a) Kindengele, kindengele, kindengele !"
    },
    {
     "id": "p009.s08",
     "source": "O beste Zwina!"
    },
    {
     "id": "p009.s09",
     "source": "Kindengele, kindengele, kindengele!"
    },
    {
     "id": "p009.s10",
     "source": "Ik ben aan Zwina gestorven."
    },
    {
     "id": "p009.s11",
     "source": "Mbengo. b) E Nkandi yaya, Nkandi yiganga ngangu!"
    },
    {
     "id": "p009.s12",
     "source": "Kilelele!"
    },
    {
     "id": "p009.s13",
     "source": "E, e!"
    },
    {
     "id": "p009.s14",
     "source": "Kibangu. [ ] b) He, beste palmnoot, He, palmnoot, ik ben verstandig!"
    },
    {
     "id": "p009.s15",
     "source": "Kilelele !"
    },
    {
     "id": "p009.s16",
     "source": "He, he!"
    },
    {
     "id": "p009.s17",
     "source": "Kibangu. [ ]"
    }
   ],
   "id": "p009"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p010.s01",
     "source": "IX."
    },
    {
     "id": "p010.s02",
     "source": "Nkunga IX."
    },
    {
     "id": "p010.s03",
     "source": "Lied Kutanga : Ikuenda kindimba-ndimba, ivutuka kindimba-ndimba; ibonga bana ba mbende bau batatu, bansisila Ntenda di Mputu."
    },
    {
     "id": "p010.s04",
     "source": "Proza : Ik ga langs een kleine vallei, ik trek terug langs een kleine vallei; ik neem drie kleine muizen op, die Ntenda di Mputu daar gelaten heeft."
    },
    {
     "id": "p010.s05",
     "source": "Nkunga : Ntenda di Mputu uzonzika tembila tadi."
    },
    {
     "id": "p010.s06",
     "source": "Tembila tadi, mpakasa kadumbi mu nkoko."
    },
    {
     "id": "p010.s07",
     "source": "Kadumbi mu nkoko, beno lukuenda ku gata."
    },
    {
     "id": "p010.s08",
     "source": "Lukuenda ku gata, lunsamununa Mbala zi Mbata!"
    },
    {
     "id": "p010.s09",
     "source": "Mbala zi Mbata katwadila wandu muna tutu."
    },
    {
     "id": "p010.s10",
     "source": "Wandu muna tutu igana ku banganga bakumbuka."
    },
    {
     "id": "p010.s11",
     "source": "Ba nganga bakumbuka, bankatuele nsongo muna nitu."
    },
    {
     "id": "p010.s12",
     "source": "Nsongo muna nitu usambukidi bana bangani."
    },
    {
     "id": "p010.s13",
     "source": "Bana bangani batetila nkandi kuna kosi."
    },
    {
     "id": "p010.s14",
     "source": "Io!"
    },
    {
     "id": "p010.s15",
     "source": "Kisantu. [ ] Lied : Ntenda di Mputu was bezig een steen aan ’t scherpen."
    },
    {
     "id": "p010.s16",
     "source": "Terwijl hij een steen scherpte, wierp een buffel hem in de rivier."
    },
    {
     "id": "p010.s17",
     "source": "De buffel wierp hem in de rivier; gij, haast u naar het dorp."
    },
    {
     "id": "p010.s18",
     "source": "Haast u naar het dorp, en verwittigt Mbala zi Mbata ."
    },
    {
     "id": "p010.s19",
     "source": "Mbala zi Mbata, dat hij boonen in eene flesch brenge!"
    },
    {
     "id": "p010.s20",
     "source": "De boonen, die in de flesch zijn, zal ik aan de toovenaars geven om mij te heelen."
    },
    {
     "id": "p010.s21",
     "source": "De toovenaars zullen mij heelen en de ziekte van mijn lichaam afnemen."
    },
    {
     "id": "p010.s22",
     "source": "De ziekte, die op mijn lichaam lag, heeft andermans kinderen aangetast."
    },
    {
     "id": "p010.s23",
     "source": "Andermans kinderen hebben de kern van de palmnoot op hunnen nek in stukken geslagen."
    },
    {
     "id": "p010.s24",
     "source": "Io!"
    },
    {
     "id": "p010.s25",
     "source": "Kisantu. [ ]"
    }
   ],
   "id": "p010"
  },
  {
   "type": "break",
   "segments": [],
   "id": "p011"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p012.s01",
     "source": "De Staat had bevolen, dat al de gehuchten van een dorp zich zouden vereenigen op een plaats."
    },
    {
     "id": "p012.s02",
     "source": "De inboorlingen hadden dat volbracht."
    },
    {
     "id": "p012.s03",
     "source": "Maar dan stierven er velen aan de slaapziekte."
    },
    {
     "id": "p012.s04",
     "source": "In die omstandigheden werd dit lied aangeheven, dat heel droevig luidt. ↑"
    }
   ],
   "id": "p012"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p013.s01",
     "source": "In ’t droog seizoen zijn de nachten koud en eenieder tracht dan een goed beddedeken te koopen. ↑"
    }
   ],
   "id": "p013"
  },
  {
