   "segments": [
    {
     "id": "p078.s01",
     "source": "When Lion at last came up with the Woman, they hunted each other round a shrub."
    },
    {
     "id": "p078.s02",
     "source": "She wore many beads and arm-rings, and Lion said, \"Let me put them on!\""
    },
    {
     "id": "p078.s03",
     "source": "So she lent them to him, but he afterwards refused to return them to her."
    }
   ],
   "id": "p078"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p079.s01",
     "source": "They then hunted each other again round the shrub, till Lion fell down, and the Woman jumped upon him, and kept him there."
    },
    {
     "id": "p079.s02",
     "source": "Lion (uttering a form of conjuration) said:"
    }
