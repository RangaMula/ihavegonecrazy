  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p052.s01",
     "source": "At the dawn of day his Mother heard his wailing, and said—"
    }
   ],
   "id": "p052"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p053.s01",
     "source": "\"My Son, this is the thing which I have told thee:"
    }
   ],
   "id": "p053"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p054.s01",
     "source": "\"'Beware of the one who has pinching weapons, Who wears a tuft of tiger's tail, Of him who has white dogs!"
    },
    {
     "id": "p054.s02",
     "source": "Alas! thou son of her who is short-eared, Thou, my short-eared child!"
    },
    {
     "id": "p054.s03",
     "source": "Son of her who eats raw flesh, Thou flesh-devourer; Son of her whose nostrils are red from the prey, Thou with blood-stained nostrils!"
    },
    {
     "id": "p054.s04",
     "source": "Son of her who drinks pit-water, Thou water-drinker!'\""
    }
   ],
   "id": "p054"
  },
