 "paragraphs": [
  {
   "type": "prose",
   "segments": [
    {
     "id": "p001.s01",
     "source": "*The verses*.--In the original they are--"
    }
   ],
   "id": "p001"
  },
  {
   "type": "verse",
   "segments": [
    {
     "id": "p002.s01",
     "source": "Chândî dâ merâ chauntrâ, koî sonâ lipâî!"
    },
    {
     "id": "p002.s02",
     "source": "Kâne men merâ gûkrû, shâhzâdâ baithâ hai!"
    }
   ],
   "id": "p002"
  },
  {
   "type": "verse",
   "segments": [
    {
     "id": "p003.s01",
     "source": "My platform is of silver, plastered with gold!"
    },
    {
     "id": "p003.s02",
     "source": "Jewels are in my ears, I sit here a prince!"
    }
   ],
   "id": "p003"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p004.s01",
     "source": "*The verses*.--In the original they are--"
    }
   ],
   "id": "p004"
  },
  {
   "type": "verse",
   "segments": [
    {
     "id": "p005.s01",
     "source": "*Hadî dâ terâ chauntrâ, koî gobar lipaî!"
    },
    {
     "id": "p005.s02",
     "source": "Kâne men terî jûtî; koî gîdar baithâ hai!*"
    }
   ],
   "id": "p005"
  },
  {
   "type": "verse",
   "segments": [
    {
     "id": "p006.s01",
     "source": "Thy platform is of bones, plastered with cow-dung!"
    },
    {
     "id": "p006.s02",
     "source": "Shoes are in thy ears; some jackal sits there!"
    }
   ],
   "id": "p006"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p007.s01",
     "source": "THE SPARROW'S MISFORTUNE"
    }
   ],
   "id": "p007"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p008.s01",
     "source": "*Verses*.--In the original these are--"
    }
   ],
   "id": "p008"
  },
  {
   "type": "verse",
   "segments": [
    {
     "id": "p009.s01",
     "source": "*Saukan rangan men charhî,"
    },
    {
     "id": "p009.s02",
     "source": "Main bhî rangan men parî,*"
    }
   ],
   "id": "p009"
  },
  {
   "type": "verse",
   "segments": [
    {
     "id": "p010.s01",
     "source": "My co-wife got dyed,"
    },
    {
     "id": "p010.s02",
     "source": "I too fell into the vat."
    }
   ],
   "id": "p010"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p011.s01",
     "source": "*Verses*.--In the original--"
    }
   ],
   "id": "p011"
  },
  {
   "type": "verse",
   "segments": [
    {
     "id": "p012.s01",
     "source": "*Ik sarî, ik balî;"
    },
    {
     "id": "p012.s02",
     "source": "Ik hinak mode charhî,*"
    }
   ],
   "id": "p012"
  },
  {
   "type": "verse",
   "segments": [
    {
     "id": "p013.s01",
     "source": "One is vexed and one grieved;"
    },
    {
     "id": "p013.s02",
     "source": "And one is carried laughing on the shoulder."
    }
   ],
   "id": "p013"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p014.s01",
     "source": "The allusion here is to a common tale."
    },
    {
     "id": "p014.s02",
     "source": "The story goes that a man who had two wives wanted to cross a river."
    },
    {
     "id": "p014.s03",
     "source": "Both wives wanted to go across first with him, so in the end, leaving the elder to walk, he took the younger on his shoulder, who mocked the elder with the words--"
    }
   ],
   "id": "p014"
  },
  {
   "type": "verse",
   "segments": [
    {
     "id": "p015.s01",
     "source": "*Ik sarî, dûî balî;"
    },
    {
     "id": "p015.s02",
     "source": "Dûî jâî mûnde charhî.*"
    }
   ],
   "id": "p015"
  },
  {
   "type": "verse",
   "segments": [
    {
     "id": "p016.s01",
     "source": "First she was vexed, next she grieved;"
    },
    {
     "id": "p016.s02",
     "source": "While the other went across on the shoulder."
    }
   ],
   "id": "p016"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p017.s01",
     "source": "Hence the sting of the old sparrow's taunt."
    }
   ],
   "id": "p017"
  },
  {
   "type": "prose",
   "segments": [
    {
     "id": "p018.s01",
     "source": "*Verses*.--In the original--"
    }
   ],
   "id": "p018"
  },
  {
   "type": "verse",
   "segments": [
    {
     "id": "p019.s01",
     "source": "*Ik chamkhat hûî;"
    },
    {
     "id": "p019.s02",
     "source": "Chirî rangan charhî;"
    },
    {
     "id": "p019.s03",
     "source": "Chirâ bedan karî;"
    },
    {
     "id": "p019.s04",
     "source": "Pîpal patte jharî;"
    },
    {
     "id": "p019.s05",
     "source": "Mahîn sing jharî;"
    },
    {
     "id": "p019.s06",
     "source": "Naîn bahí khârî;"
    },
    {
     "id": "p019.s07",
     "source": "Koïl hûî kânî;"
    },
    {
     "id": "p019.s08",
     "source": "Bhagtû diwanî;"
    },
    {
     "id": "p019.s09",
     "source": "Bandî padnî;"
    },
    {
     "id": "p019.s10",
     "source": "Rânî nâchnî;"
    },
    {
     "id": "p019.s11",
     "source": "Putr dholkî bajânî;"
    },
    {
     "id": "p019.s12",
     "source": "Râjâ sargî bajânî;*"
    }
   ],
   "id": "p019"
  },
  {
   "type": "verse",
   "segments": [
    {
     "id": "p020.s01",
     "source": "One hen painted,"
    },
    {
     "id": "p020.s02",
     "source": "And the other was dyed,"
    },
    {
     "id": "p020.s03",
     "source": "And the cock loved her,"
    },
    {
     "id": "p020.s04",
     "source": "So the *pîpal* shed its leaves,"
    },
    {
     "id": "p020.s05",
     "source": "And the buffalo her horns,"
    },
    {
     "id": "p020.s06",
     "source": "So the river became salt,"
    },
    {
     "id": "p020.s07",
     "source": "And the cuckoo lost an eye,"
    },
    {
     "id": "p020.s08",
     "source": "So Bhagtû went mad,"
    },
    {
     "id": "p020.s09",
     "source": "And the maid took to swearing,"
    },
    {
     "id": "p020.s10",
     "source": "So the Queen took to dancing,"
    },
    {
     "id": "p020.s11",
     "source": "And the Prince took to drumming,"
    },
    {
     "id": "p020.s12",
     "source": "And the King took to thrumming."
    }
   ],
   "id": "p020"
  }
 ]
}