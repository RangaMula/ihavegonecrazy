{"result":{"id":"1159","sura":"7","aya":"205","arabic_text":"\u0648\u064e\u0671\u0630\u06e1\u0643\u064f\u0631 \u0631\u0651\u064e\u0628\u0651\u064e\u0643\u064e \u0641\u0650\u064a \u0646\u064e\u0641\u06e1\u0633\u0650\u0643\u064e \u062a\u064e\u0636\u064e\u0631\u0651\u064f\u0639\u0657\u0627 \u0648\u064e\u062e\u0650\u064a\u0641\u064e\u0629\u0657 \u0648\u064e\u062f\u064f\u0648\u0646\u064e \u0671\u0644\u06e1\u062c\u064e\u0647\u06e1\u0631\u0650 \u0645\u0650\u0646\u064e \u0671\u0644\u06e1\u0642\u064e\u0648\u06e1\u0644\u0650 \u0628\u0650\u0671\u0644\u06e1\u063a\u064f\u062f\u064f\u0648\u0651\u0650 \u0648\u064e\u0671\u0644\u06e1\u0623\u0653\u0635\u064e\u0627\u0644\u0650 \u0648\u064e\u0644\u064e\u0627 \u062a\u064e\u0643\u064f\u0646 \u0645\u0651\u0650\u0646\u064e \u0671\u0644\u06e1\u063a\u064e\u0670\u0641\u0650\u0644\u0650\u064a\u0646\u064e","translation":"\u0986\u09b0 \u0986\u09aa\u09a8\u09bf \u0986\u09aa\u09a8\u09be\u09b0 \u09b0\u09ac\u0995\u09c7 \u09a8\u09bf\u099c \u09ae\u09a8\u09c7 \u09b8\u09cd\u09ae\u09b0\u09a3 \u0995\u09b0\u09c1\u09a8 [\u09e7] \u09b8\u09ac\u09bf\u09a8\u09af\u09bc\u09c7, \u09b8\u09b6\u0982\u0995\u099a\u09bf\u09a4\u09cd\u09a4\u09c7 \u0993 \u0985\u09a8\u09c1\u099a\u09cd\u099a\u09b8\u09cd\u09ac\u09b0\u09c7, \u09b8\u0995\u09be\u09b2\u09c7 \u0993 \u09b8\u09a8\u09cd\u09a7\u09cd\u09af\u09be\u09df\u0964 \u0986\u09b0 \u0989\u09a6\u09be\u09b8\u09c0\u09a8\u09a6\u09c7\u09b0 \u0985\u09a8\u09cd\u09a4\u09b0\u09cd\u09ad\u09c1\u0995\u09cd\u09a4 \u09b9\u09ac\u09c7\u09a8 \u09a8\u09be\u0964","footnotes":"[\u09e7]  \u09b8\u09cd\u09ae\u09b0\u09a3 \u0995\u09b0\u09be \u0985\u09b0\u09cd\u09a5 \u09b8\u09be\u09b2\u09be\u09a4\u0993 \u098f\u09ac\u0982 \u0985\u09a8\u09cd\u09af\u09be\u09a8\u09cd\u09af \u09a7\u09b0\u09a8\u09c7\u09b0 \u09b8\u09cd\u09ae\u09b0\u09a3 \u0995\u09b0\u09be\u0993\u0964 \u099a\u09be\u0987 \u09ae\u09c1\u0996\u09c7 \u09ae\u09c1\u0996\u09c7 \u09ac\u09be \u09ae\u09a8\u09c7 \u09ae\u09a8\u09c7 \u09af\u09c7 \u0995\u09cb\u09a8\u09cb\u09ad\u09be\u09ac\u09c7\u0987 \u09a4\u09be \u09b9\u09cb\u0995 \u09a8\u09be \u0995\u09c7\u09a8\u0964 \u09b8\u0995\u09be\u09b2-\u09b8\u09be\u099d \u09ac\u09b2\u09a4\u09c7 \u09b8\u09c1\u09a8\u09bf\u09b0\u09cd\u09a6\u09bf\u09b7\u09cd\u099f\u09ad\u09be\u09ac\u09c7 \u098f \u09a6\u09c1\u2019\u099f\u09bf \u09b8\u09ae\u09af\u09bc\u0993 \u09ac\u09c1\u099d\u09be\u09a8\u09cb \u09b9\u09af\u09bc\u09c7 \u09a5\u09be\u0995\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u0964 \u0986\u09b0 \u098f \u09a6\u09c1' \u09b8\u09ae\u09af\u09bc\u09c7 \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09b0 \u09b8\u09cd\u09ae\u09b0\u09a3 \u09ac\u09b2\u09a4\u09c7 \u09ac\u09c1\u099d\u09be\u09a8\u09cb \u09b9\u09af\u09bc\u09c7\u099b\u09c7 \u09b8\u0995\u09be\u09b2\u09c7\u09b0 \u0993 \u09ac\u09bf\u0995\u09be\u09b2\u09c7\u09b0 \u09b8\u09be\u09b2\u09be\u09a4\u0995\u09c7\u0964 [\u09a4\u09be\u09ac\u09be\u09b0\u09c0] \u0985\u09a8\u09c1\u09b0\u09c2\u09aa \u0985\u09b0\u09cd\u09a5\u09c7 \u0985\u09aa\u09b0 \u09b8\u09c2\u09b0\u09be\u09af\u09bc \u098f\u09b8\u09c7\u099b\u09c7, \u201c\u098f\u09ac\u0982 \u0986\u09aa\u09a8\u09be\u09b0 \u09b0\u09ac\u09c7\u09b0 \u09b8\u09aa\u09cd\u09b0\u09b6\u0982\u09b8 \u09aa\u09ac\u09bf\u09a4\u09cd\u09b0\u09a4\u09be \u0993 \u09ae\u09b9\u09bf\u09ae\u09be \u0998\u09cb\u09b7\u09a3\u09be \u0995\u09b0\u09c1\u09a8 \u09b8\u09c2\u09b0\u09cd\u09af\u09cb\u09a6\u09af\u09bc\u09c7\u09b0 \u0986\u0997\u09c7 \u0993 \u09b8\u09c2\u09b0\u09cd\u09af\u09be\u09b8\u09cd\u09a4\u09c7\u09b0 \u0986\u0997\u09c7\u0964\u201d [\u09b8\u09c2\u09b0\u09be \u0995\u09be\u09ab \u09e9\u09ef] \u09aa\u0995\u09cd\u09b7\u09be\u09a8\u09cd\u09a4\u09b0\u09c7 \u09b8\u0995\u09be\u09b2-\u09b8\u09be\u0981\u099d \u0995\u09a5\u09be\u099f\u09be \u201c\u09b8\u09b0\u09cd\u09ac\u0995\u09cd\u09b7\u09a3\" \u0985\u09b0\u09cd\u09a5\u09c7\u0993 \u09ac\u09cd\u09af\u09ac\u09b9\u09c3\u09a4 \u09b9\u09af\u09bc [\u0995\u09be\u09b6\u09b6\u09be\u09ab] \u098f\u09ac\u0982 \u09a4\u0996\u09a8 \u098f\u09b0 \u0985\u09b0\u09cd\u09a5 \u09b9\u09af\u09bc \u09b8\u09ac\u09b8\u09ae\u09af\u09bc \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09b0 \u09b8\u09cd\u09ae\u09b0\u09a3\u09c7 \u09ae\u09b6\u0997\u09c1\u09b2 \u09a5\u09be\u0995\u09be\u0964 \u098f\u09b0 \u0989\u09a6\u09cd\u09a6\u09c7\u09b6\u09cd\u09af \u09ac\u09b0\u09cd\u09a3\u09a8\u09be \u09aa\u09cd\u09b0\u09b8\u0982\u0997\u09c7 \u09ac\u09b2\u09be \u09b9\u09af\u09bc\u09c7\u099b\u09c7, \u09a4\u09cb\u09ae\u09be\u09a6\u09c7\u09b0 \u0985\u09ac\u09b8\u09cd\u09a5\u09be \u09af\u09c7\u09a8 \u0997\u09be\u09ab\u09c7\u09b2\u09a6\u09c7\u09b0 \u09ae\u09a4 \u09a8\u09be \u09b9\u09af\u09bc\u09c7 \u09af\u09be\u09af\u09bc\u0964 \u09a6\u09c1\u09a8\u09bf\u09af\u09bc\u09be\u09af\u09bc \u09af\u09be \u0995\u09bf\u099b\u09c1 \u0997\u09cb\u09ae\u09b0\u09be\u09b9\u09c0 \u099b\u09a1\u09bc\u09bf\u09af\u09bc\u09c7\u099b\u09c7 \u098f\u09ac\u0982 \u09ae\u09be\u09a8\u09c1\u09b7\u09c7\u09b0 \u09a8\u09c8\u09a4\u09bf\u0995 \u099a\u09b0\u09bf\u09a4\u09cd\u09b0\u09c7 \u0993 \u0995\u09b0\u09cd\u09ae\u0995\u09be\u09a3\u09cd\u09a1\u09c7 \u09af\u09c7 \u09ac\u09bf\u09aa\u09b0\u09cd\u09af\u09af\u09bc\u0987 \u09b8\u09c3\u09b7\u09cd\u099f\u09bf \u09b9\u09af\u09bc\u09c7\u099b\u09c7 \u09a4\u09be\u09b0 \u098f\u0995\u09ae\u09be\u09a4\u09cd\u09b0 \u0995\u09be\u09b0\u09a3 \u09b9\u099a\u09cd\u099b\u09c7, \u09ae\u09be\u09a8\u09c1\u09b7 \u09ad\u09c1\u09b2\u09c7 \u09af\u09be\u09af\u09bc, \u0986\u09b2\u09cd\u09b2\u09be\u09b9 \u09a4\u09be\u09b0 \u09b0\u09ac, \u09b8\u09c7 \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09b0 \u09ac\u09be\u09a8\u09cd\u09a6\u09be, \u09a6\u09c1\u09a8\u09bf\u09af\u09bc\u09be\u09b0 \u099c\u09c0\u09ac\u09a8 \u09b6\u09c7\u09b7 \u09b9\u0993\u09df\u09be\u09b0 \u09aa\u09b0 \u09a4\u09be\u0995\u09c7 \u09a4\u09be\u09b0 \u09b0\u09ac\u09c7\u09b0 \u0995\u09be\u099b\u09c7 \u09b9\u09bf\u09b8\u09be\u09ac \u09a6\u09bf\u09a4\u09c7 \u09b9\u09ac\u09c7\u0964"}}